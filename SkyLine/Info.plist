<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app makes only HTTPS calls and uses no non-exempt encryption of its
	     own. Declaring it here means a build is not held in "Missing Compliance"
	     in App Store Connect until someone answers the export questionnaire by
	     hand, which otherwise happens once per build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Photo access. Both picker call sites use SwiftUI's `.photosPicker`,
	     which runs out of process and never prompts - so this string exists
	     only to be read by App Review, and it has to describe what the app
	     actually does. The previous one described the retired photo-library
	     place scan and promised "your photos stay on your device", which is
	     not true of a pass sent to the remote parser. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SkyLine reads the boarding pass or booking confirmation you choose, so it can add the flight without you typing it in.</string>

	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<key>UIAppFonts</key>
	<array>
		<string>GeistMono-Regular.ttf</string>
		<string>GeistMono-Medium.ttf</string>
		<string>GeistMono-SemiBold.ttf</string>
		<string>GeistMono-Bold.ttf</string>
	</array>
</dict>
</plist>
